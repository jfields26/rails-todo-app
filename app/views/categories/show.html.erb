<!--Jarred Fields-->

<div class="container-fluid px-4">
  <h2><%= @category.name %></h2>

  <p><%= @category.description %></p>

  <div class="d-flex gap-2 mt-2">
    <%= link_to "Edit", edit_category_path(@category, return_to: category_path(@category)), class: "btn btn-outline-secondary" %>
    <%= link_to "Back", categories_path, class: "btn btn-outline-primary" %>
    <%= button_to "Delete", @category, method: :delete, class: "btn btn-outline-dark" %>
  </div>

  <hr>

  <h4 class="text-center mt-3">ToDos in this Category</h4>

  <div class="d-flex flex-wrap gap-2 mt-3">
    <% @category.todos.each do |todo| %>
      <%= link_to todo.title, todo_path(todo, origin: "category"), class: "btn btn-info" %>
    <% end %>
  </div>
</div>