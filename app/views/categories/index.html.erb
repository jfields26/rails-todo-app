<p style="color: green"><%= notice %></p>

<% content_for :title, "Categories" %>

<h1>Categories</h1>

<div id="categories">
  <% @categories.each do |category| %>
    <%= render category %>
    <p>
      <%= link_to "Show this category", category_path(category, return_to: request.fullpath), class: "btn btn-sm btn-outline-info" %>
    </p>
  <% end %>
</div>

<%= link_to "New category", new_category_path, class: "btn btn-outline-dark mt-3" %>
