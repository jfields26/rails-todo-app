<!-- Jarred Fields -->

<h1>Completed ToDos</h1>

<div class="container-fluid px-4">
  <% @todos.each do |todo| %>

    <div class="card mb-2 p-3 w-100 shadow-sm">

      <h5>
        <%= todo.title %>
        <span class="badge bg-success">Completed</span>
      </h5>


      <div class="mt-2">
        <%= link_to "View", todo_path(todo), class: "btn btn-sm btn-outline-primary" %>
      </div>

    </div>

  <% end %>
</div>