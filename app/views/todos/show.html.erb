<!-- Jarred Fields -->

<p style="color: green"><%= notice %></p>

<h1><%= @todo.title %></h1>

<p>
  <strong>Category:</strong>
  <%= @todo.category.name %>
</p>

<p>
  <strong>Priority:</strong>
  <%= @todo.priority ? "Yes" : "No" %>
</p>

<p>
  <strong>Completed:</strong>
  <%= @todo.completed ? "Yes" : "No" %>
</p>

<% if @todo.notes.present? %>
  <p>
    <strong>Notes:</strong>
    <%= simple_format(@todo.notes) %>
  </p>
<% end %>

<div class="d-flex gap-2 mt-3">
  <%= link_to "Edit this todo", edit_todo_path(@todo, source: params[:source]), class: "btn btn-outline-secondary" %>
  <%= button_to "Destroy this todo", @todo, method: :delete, class: "btn btn-outline-dark" %>
  
  <% back_path =
    case params[:source]
    when "completed"
      todos_completed_path
    when "categories"
      category_path(@todo.category)
    else
      todos_path
    end %>
  
  <%= link_to "Back", back_path, class: "btn btn-outline-primary" %>
</div>