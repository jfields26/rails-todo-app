<!-- Jarred Fields -->

<h2>Account Settings</h2>

<p><strong>First Name:</strong> <%= @user.first_name %></p>
<p><strong>Last Name:</strong> <%= @user.last_name %></p>
<p><strong>Email:</strong> <%= @user.email %></p>

<hr>

<h4>Stats</h4>
<p>Total Categories: <%= @user.categories.count %></p>
<p>Total Todos: <%= @user.todos.count %></p>
<p>Completed Todos: <%= @user.todos.where(completed: true).count %></p>
<p>Incomplete Todos: <%= @user.todos.where(completed: false).count %></p>

<hr>

<div class="d-flex gap-2 flex-wrap">

  <%= link_to "Edit Info", edit_account_path, class: "btn btn-outline-primary" %>

  <%= link_to "Change Password", account_verify_password_path, class: "btn btn-outline-secondary" %>

  <%= button_to destroy_user_session_path, method: :delete, class: "btn btn-outline-dark" do %>
    Log Out
  <% end %>

  <%= button_to user_registration_path,
      method: :delete,
      data: { confirm: "Are you sure?" },
      class: "btn btn-outline-danger" do %>
    <i class="fa fa-trash"></i> Delete Account
  <% end %>

</div>