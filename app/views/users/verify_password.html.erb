<div class="d-flex justify-content-center align-items-center vh-100">
  <div class="text-center">

    <h2>Enter Current Password</h2>

    <% if flash[:alert] %>
      <p class="text-danger"><%= flash[:alert] %></p>
    <% end %>

    <%= form_with url: account_check_password_path, method: :post, local: true do %>
      <div class="mb-3">
        <%= password_field_tag :current_password, nil, class: "form-control password-input" %>
      </div>

      <%= submit_tag "Verify", class: "btn btn-primary" %>
    <% end %>

  </div>
</div>