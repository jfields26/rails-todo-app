<div class="d-flex justify-content-center align-items-center vh-100">
  <div class="text-center">

    <h2>Change Password</h2>

    <% if flash[:alert] %>
      <p class="text-danger"><%= flash[:alert] %></p>
    <% end %>

    <p class="text-muted">
      Password must include at least:
      <br>• 6 characters
      <br>• 1 uppercase letter
      <br>• 1 number or special character
    </p>

    <%= form_with url: account_update_password_path, method: :patch, local: true do %>

      <div class="mb-2">
        <%= password_field_tag :password, nil, id: "password_field", class: "form-control password-input", placeholder: "New Password" %>
      </div>

      <div class="mb-2">
        <%= password_field_tag :password_confirmation, nil, id: "password_confirmation_field", class: "form-control password-input", placeholder: "Confirm Password" %>
      </div>

      <%= submit_tag "Update Password", class: "btn btn-success mt-2" %>

      <div class="mt-3 d-flex justify-content-center gap-2">
        <%= link_to "Cancel", account_path, class: "btn btn-outline-secondary" %>
      </div>

    <% end %>

  </div>
</div>