<!--Jarred Fields-->

<div class="d-flex justify-content-center align-items-center vh-100">
  <div class="text-center" style="min-width: 300px; max-width: 400px; width: 100%;">

    <h2>Sign up</h2>
    <p class="mt-2">Please log in or sign up</p>

    <%= render "devise/shared/error_messages", resource: resource %>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { data: { turbo: false } }) do |f| %>

      <div class="form-group mt-3 text-start">
        <%= f.label :first_name %>
        <%= f.text_field :first_name, class: "form-control" %>
      </div>

      <div class="form-group mt-3 text-start">
        <%= f.label :last_name %>
        <%= f.text_field :last_name, class: "form-control" %>
      </div>

      <div class="form-group mt-3 text-start">
        <%= f.label :username %>
        <%= f.text_field :username, class: "form-control" %>
      </div>

      <div class="form-group mt-3 text-start">
        <%= f.label :email %>
        <%= f.email_field :email, class: "form-control" %>
      </div>

      <p class="text-muted">
        Password must include at least:
        <br>• 6 characters
        <br>• 1 uppercase letter
        <br>• 1 number or special character
      </p>

      <div class="form-group mt-3 text-start">
        <%= f.label :password %>
        <%= f.password_field :password, id: "password_field", class: "form-control password-input" %>
      </div>

      <div class="form-group mt-3 text-start">
        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, id: "password_confirmation_field", class: "form-control password-input" %>
      </div>

      <div class="mt-4">
        <%= f.submit "Sign up", class: "btn btn-success w-100" %>
      </div>

    <% end %>

    <div class="mt-3">
      <%= link_to "Already have an account? Log in", new_user_session_path, class: "btn btn-outline-primary w-100" %>
    </div>

  </div>
</div>