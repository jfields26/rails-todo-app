<div class="d-flex justify-content-center align-items-center vh-100">
  <div class="text-center" style="min-width: 300px; max-width: 400px; width: 100%;">

    <h2>Log in</h2>
    <p class="mt-2">Please log in or sign up</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

      <div class="form-group mt-3 text-start">
        <%= f.label :email %>
        <%= f.email_field :email, class: "form-control" %>
      </div>

      <div class="form-group mt-3 text-start">
        <%= f.label :password %>
        <%= f.password_field :password, class: "form-control password-input" %>
      </div>

      <div class="form-group mt-3 text-start">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me, style: "display: inline" %>
      </div>

      <div class="mt-4">
        <%= f.submit "Log in", class: "btn btn-primary w-100" %>
      </div>

    <% end %>

    <div class="mt-3 d-flex flex-column gap-2">
      <%= link_to "Forgot password?", new_user_password_path, class: "btn btn-outline-secondary w-100" %>
      <%= link_to "Sign up", new_user_registration_path, class: "btn btn-outline-success w-100" %>
    </div>

  </div>
</div>