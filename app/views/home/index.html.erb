<!-- Jarred Fields -->

<div class="d-flex justify-content-center align-items-center vh-100">

  <div class="text-center">

    <h1>Welcome to the Todo App</h1>

    <% if user_signed_in? %>
      <p class="mt-3">You are logged in</p>
      <%= link_to "Go to Categories", categories_path, class: "btn btn-primary" %>

    <% else %>
      <p class="mt-3">Please log in or sign up</p>

      <div class="mt-3">
        <%= link_to "Sign up", new_user_registration_path, class: "btn btn-success me-2" %>
        <%= link_to "Log in", new_user_session_path, class: "btn btn-primary" %>
      </div>
    <% end %>

  </div>

</div>