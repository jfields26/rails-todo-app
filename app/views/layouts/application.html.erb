<!DOCTYPE html>
<html>
  <head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <title><%= content_for(:title) || "Todo App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <script>
    document.addEventListener("turbo:load", function () {
      const passwordInput = document.getElementById("password_field");
      if (!passwordInput) return;

      if (passwordInput.dataset.listenerAttached) return;
      passwordInput.dataset.listenerAttached = "true";

      let bar = document.getElementById("password_strength_bar");

      if (!bar) {
        bar = document.createElement("div");
        bar.id = "password_strength_bar";
        bar.style.height = "8px";
        bar.style.marginTop = "6px";
        bar.style.borderRadius = "4px";
        bar.style.backgroundColor = "#ddd";

        const fill = document.createElement("div");
        fill.id = "password_strength_fill";
        fill.style.height = "100%";
        fill.style.width = "0%";
        fill.style.borderRadius = "4px";
        fill.style.transition = "width 0.3s ease";

        bar.appendChild(fill);
        passwordInput.parentNode.appendChild(bar);
      }

      const fill = document.getElementById("password_strength_fill");

      passwordInput.addEventListener("input", function () {
        const value = passwordInput.value;

        let score = 0;

        if (value.length >= 6) score++;
        if (/[A-Z]/.test(value)) score++;
        if (/\d/.test(value) || /[^A-Za-z0-9]/.test(value)) score++;
        if (value.length >= 10) score++;

        const percent = (score / 4) * 100;
        fill.style.width = percent + "%";

        if (score <= 1) {
          fill.style.backgroundColor = "red";
        } else if (score === 2) {
          fill.style.backgroundColor = "orange";
        } else if (score === 3) {
          fill.style.backgroundColor = "gold";
        } else {
          fill.style.backgroundColor = "green";
        }
      });
    });
  </script>

  <script>
    document.addEventListener("turbo:load", function () {
      const pw = document.getElementById("password_field");
      const confirm = document.getElementById("password_confirmation_field");

      if (!pw || !confirm) return;

      let matchText = document.getElementById("password_match_text");

      if (!matchText) {
        matchText = document.createElement("div");
        matchText.id = "password_match_text";
        matchText.style.marginTop = "5px";
        matchText.style.fontWeight = "600";
        confirm.parentNode.appendChild(matchText);
      }

      function checkMatch() {
        if (!confirm.value) {
          matchText.textContent = "";
          return;
        }

        if (pw.value === confirm.value) {
          matchText.textContent = "Passwords match ✓";
          matchText.style.color = "green";
        } else {
          matchText.textContent = "Passwords do not match";
          matchText.style.color = "red";
        }
      }

      pw.addEventListener("input", checkMatch);
      confirm.addEventListener("input", checkMatch);
    });
  </script>

  <script>
    document.addEventListener("turbo:load", function () {
      document.querySelectorAll(".password-input").forEach(function (input) {

        // prevent duplicate toggles
        if (input.dataset.toggleAttached) return;
        input.dataset.toggleAttached = "true";

        const wrapper = document.createElement("div");
        wrapper.style.position = "relative";

        input.parentNode.insertBefore(wrapper, input);
        wrapper.appendChild(input);

        const button = document.createElement("button");
        button.type = "button";
        button.innerHTML = '<i class="fa fa-eye"></i>';
        button.style.position = "absolute";
        button.style.right = "10px";
        button.style.top = "50%";
        button.style.transform = "translateY(-50%)";
        button.style.border = "none";
        button.style.background = "transparent";
        button.style.cursor = "pointer";

        wrapper.appendChild(button);

        button.addEventListener("click", function () {
          if (input.type === "password") {
            input.type = "text";
            button.innerHTML = '<i class="fa fa-eye-slash"></i>';
          } else {
            input.type = "password";
            button.innerHTML = '<i class="fa fa-eye"></i>';
          }
        });
      });
    });
  </script>

  <body style="padding-top: 70px;">
    <nav class="navbar navbar-expand-lg navbar-light bg-light fixed-top px-3 shadow-sm">
      <div class="nav-left">
        <% if user_signed_in? %>
          <%= link_to "ToDos", todos_path %>
          <%= link_to "Categories", categories_path %>
          <%= link_to "Completed ToDos", "/todos/completed" %>
        <% end %>
      </div>


      <div class="nav-right">
        <% if user_signed_in? %>
          <div class="d-flex align-items-center ms-auto gap-2">
            <%= link_to account_path, class: "btn btn-outline-secondary" do %>
              <i class="fa fa-gear"></i> Settings
            <% end %>
            <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "btn btn-outline-dark" %>
          </div>
        <% else %>
          <%= link_to "Home", root_path, class: "btn btn-outline-primary" %>
        <% end %>
      </div>
    </nav>

    <div class="text-center mt-2">
      <% if user_signed_in? %>
        <p class="text-center fw-semibold mt-2">Welcome, <%= current_user.first_name %></p>
      <% elsif !["home", "sessions", "registrations"].include?(controller_name) %>
        <p>Please log in or sign up</p>
      <% end %>

      <hr>
    </div>

    <%= yield %>
  </body>
</html>
